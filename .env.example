ITAD_API_KEY=
# URL pública do site, sem barra no final (canonical, sitemap e Open Graph)
NUXT_PUBLIC_SITE_URL=https://seu-dominio.com.br
# Postgres (Neon). Vazio em desenvolvimento: usa um banco local em .data/pglite
DATABASE_URL=
# 32+ caracteres aleatórios; assina a sessão e os links de sair dos emails
NUXT_SESSION_PASSWORD=
# Resend. Vazio: os emails vão para o log do servidor
RESEND_API_KEY=
# Remetente, de um domínio verificado no Resend
EMAIL_FROM=
# Segredo que a Vercel envia ao chamar o cron
CRON_SECRET=
# 'true' mostra contas e alertas (só depois de ter domínio próprio)
NUXT_PUBLIC_ACCOUNTS_ENABLED=
